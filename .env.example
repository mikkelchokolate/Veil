# Veil Configuration Template
# Copy this file to .env and set your secrets before running:
# docker compose up -d

# REQUIRED: API authentication token (must be a random secure token, e.g. 32+ characters)
VEIL_API_TOKEN=your-random-secure-32-byte-token-here

# OPTIONAL: Custom web panel base path slug (e.g. /secret-panel/)
# VEIL_WEB_BASE_PATH=/

# OPTIONAL: Auto Let's Encrypt TLS settings
# VEIL_AUTO_TLS=0
# VEIL_AUTO_TLS_DIR=/var/lib/veil/autocert
