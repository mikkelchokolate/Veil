[Unit]
Description=Veil managed WARP/sing-box outbound
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sing-box run -c /etc/veil/generated/sing-box/warp.json
ExecReload=/usr/local/bin/sing-box check -c /etc/veil/generated/sing-box/warp.json
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
ReadWritePaths=/etc/veil /var/lib/veil

[Install]
WantedBy=multi-user.target
