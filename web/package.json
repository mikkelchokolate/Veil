{
	"name": "veil-web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "node_modules/.bin/vite",
		"build": "node_modules/.bin/tsc -b && node_modules/.bin/vite build",
		"typecheck": "node_modules/.bin/tsc -b --noEmit",
		"check": "node_modules/.bin/biome check .",
		"check:fix": "node_modules/.bin/biome check --write .",
		"gen": "node node_modules/orval/dist/bin/orval.mjs --config orval.config.ts",
		"test": "vitest run",
		"test:browser": "node_modules/.bin/vitest run --browser.enabled",
		"test:e2e": "node_modules/.bin/playwright test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@tanstack/react-query": "^5.90.0",
		"@tanstack/react-router": "^1.139.0",
		"@tanstack/react-table": "^8.21.0",
		"echarts": "^6.1.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-hook-form": "^7.66.0",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.3",
		"jsdom": "^29.1.1",
		"msw": "^2.15.0",
		"orval": "^8.22.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
