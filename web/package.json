{
	"name": "veil-web",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@11.22.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsr generate && tsc -b && vite build && node scripts/check_bundle_size.mjs",
		"i18n:check": "python3 scripts/i18n_check.py && node scripts/i18n_leaks.mjs",
		"typecheck": "tsr generate && tsc -b --noEmit",
		"router:gen": "tsr generate",
		"check": "biome check --error-on-warnings .",
		"check:fix": "biome check --write .",
		"gen": "orval --config orval.config.ts",
		"postinstall": "node scripts/prepare_msw_worker.mjs",
		"test": "node --no-experimental-webstorage ./node_modules/vitest/vitest.mjs run --project=jsdom",
		"test:browser": "vitest run --project=browser",
		"test:e2e": "playwright test",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"@radix-ui/react-alert-dialog": "^1.1.23",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@radix-ui/react-tabs": "^1.1.21",
		"@radix-ui/react-toast": "^1.2.23",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.31",
		"@tanstack/react-table": "^9.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"echarts": "^6.1.0",
		"lucide-react": "^1.33.0",
		"qrcode": "^1.5.4",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.85.0",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@babel/parser": "8.0.4",
		"@biomejs/biome": "^2.5.10",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/router-cli": "^1.167.32",
		"@tanstack/router-plugin": "^1.168.34",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"@vitest/browser-playwright": "^4.1.11",
		"jsdom": "^30.0.1",
		"msw": "^2.15.0",
		"orval": "^8.25.0",
		"playwright": "^1.62.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	}
}
